{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AMG Shotcraft Script Schema",
  "type": "object",
  "required": ["projectSlug", "trackId", "resolution", "totalDurationMs", "seed", "scenes"],
  "properties": {
    "projectSlug": { "type": "string" },
    "trackId": { "type": "string" },
    "resolution": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "integer" }
      }
    },
    "totalDurationMs": { "type": "integer" },
    "seed": { "type": "integer" },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sceneId", "title", "startMs", "endMs", "shotcraftCardId", "cameraRig", "morphBridgeToNext"],
        "properties": {
          "sceneId": { "type": "string" },
          "title": { "type": "string" },
          "startMs": { "type": "integer" },
          "endMs": { "type": "integer" },
          "shotcraftCardId": { "type": "string" },
          "cameraRig": {
            "type": "object",
            "properties": {
              "initial": { "type": "object" },
              "target": { "type": "object" },
              "ease": { "type": "string" }
            }
          },
          "morphBridgeToNext": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "sourceElementId": { "type": "string" },
              "targetElementId": { "type": "string" },
              "transitionDurationMs": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
